# Dimuat server dari working directory pada dev dan production.
# Environment proses memiliki prioritas atas file ini.
# Jangan gunakan prefix VITE_ untuk kunci API atau taruh .env di dist/.
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""
CLAUDE_API_KEY=""
HF_API_KEY=""
OPENAI_API_KEY=""

# Bilangan bulat 1-65535; server tetap bind 127.0.0.1.
PORT=3000
# NODE_ENV ditentukan entry point: npm run dev / npm start.
# APP_URL tidak digunakan oleh aplikasi/proxy.
